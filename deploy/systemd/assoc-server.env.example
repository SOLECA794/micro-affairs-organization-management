# =============================================================
# 环境变量文件模板（systemd EnvironmentFile 引用）
# 复制到 /opt/association-system/assoc-server.env 后按实际值填写
# 权限要求：chmod 600，属主 assoc
# =============================================================

# 数据源（数据库部署在本机时的示例）
# 注意：characterEncoding 必须是 Java 字符集名（UTF-8），驱动会自动映射到 MySQL 的 utf8mb4
DB_URL=jdbc:mysql://127.0.0.1:3306/association_system?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=association
DB_PASSWORD=__数据库密码__

# JWT 签名密钥：不少于 32 字节随机串（示例生成：openssl rand -base64 48）
JWT_SECRET=__替换为随机长密钥__

# 扫码二维码基地址（当前 HTTP 演示环境，暂无域名）
QRCODE_BASE_URL=http://114.55.31.135
FRONT_BASE_URL=http://114.55.31.135
